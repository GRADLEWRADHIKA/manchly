SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # from Supabase Dashboard → Settings → API
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
PORT=8080
NODE_ENV=development


# SMTP settings for sending emails (required)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your@email.com          # required — nodemailer auth username
EMAIL_PASSWORD=your_app_password   # required — nodemailer auth password
EMAIL_FROM="Manchly <no-reply@yourdomain.com>"

# JWT secret for issuing tokens after OTP verification
JWT_SECRET=supersecretjwtkey

# Supabase storage bucket for uploads
SUPABASE_BUCKET=project-files

# Fast2SMS API (for SMS OTP & WhatsApp notifications)
FAST2SMS_API_KEY=wOp7tmsS9Q6IkZ0SQNNCe0bKqiD4TKBopKu4Awnh12zzp2E5trTZWBULmRs1
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=369409076262689
FAST2SMS_WHATSAPP_VERSION=v24.0

# Cashfree Payment Gateway
CASHFREE_PG_APP_ID=your_cashfree_pg_app_id
CASHFREE_PG_SECRET_KEY=your_cashfree_pg_secret_key
CASHFREE_PG_ENV=SANDBOX
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# Cashfree Payouts
CASHFREE_PAYOUT_CLIENT_ID=your_cashfree_payout_client_id
CASHFREE_PAYOUT_CLIENT_SECRET=your_cashfree_payout_client_secret
CASHFREE_PAYOUT_ENV=SANDBOX

# Decentro KYC — https://docs.decentro.tech
DECENTRO_BASE_URL=https://in.staging.decentro.tech
DECENTRO_CLIENT_ID=your_decentro_client_id
DECENTRO_CLIENT_SECRET=your_decentro_client_secret
DECENTRO_KYC_MODULE_SECRET=your_decentro_kyc_module_secret

# App URL (for generating course/webinar links in notifications)
APP_URL=https://manchly.com

# Zoom Server-to-Server OAuth (required for published webinars)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Legacy aliases (optional — ZOOM_CLIENT_ID/ZOOM_CLIENT_SECRET are preferred)
# ZOOM_OAUTH_CLIENT_ID=
# ZOOM_OAUTH_CLIENT_SECRET=
# Legacy JWT auth (optional fallback)
# ZOOM_API_KEY=
# ZOOM_API_SECRET=

# Telegram Bot (paid channel access)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ManchlyBot
TELEGRAM_WEBHOOK_URL=https://server.manchly.com
TELEGRAM_WEBHOOK_SECRET=
# Set to "true" to skip real Cashfree calls and use mock payment for local testing
TELEGRAM_USE_MOCK_PAYMENT=false

# ─── AI Provider (powers /ai/* endpoints) ────────────────────
# Auto-selected in this priority order:
#   1. HF_TOKEN       → HuggingFace Inference Router (OpenAI-compatible)
#   2. OPENAI_API_KEY → OpenAI
#   3. GEMINI_API_KEY → Google Gemini
#   4. (none)         → deterministic mock data, provider:"mock" in the response
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
