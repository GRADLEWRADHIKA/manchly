	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Signup",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"creator@example.com\",\n  \"phone\": \"+1234567890\",\n  \"name\": \"John Doe\",\n  \"user_type\": \"CREATOR\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/signup",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"signup"
							]
						},
						"description": "Create a new user account. User types: USER, CREATOR, ADMIN"
					},
					"response": []
				},
				{
					"name": "2. Send Email OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"creator@example.com\",\n  \"purpose\": \"login\",\n  \"tab\": \"CREATOR\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/send-email-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"send-email-otp"
							]
						},
						"description": "Send OTP to email for login/verification"
					},
					"response": []
				},
				{
					"name": "3. Send SMS OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone_number\": \"+1234567890\",\n  \"purpose\": \"login\",\n  \"tab\": \"CREATOR\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/send-sms-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"send-sms-otp"
							]
						},
						"description": "Send OTP to phone number for login/verification"
					},
					"response": []
				},
				{
					"name": "4. Verify OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.data.token);",
									"    console.log(\"JWT Token saved:\", jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"creator@example.com\",\n  \"code\": \"123456\",\n  \"purpose\": \"login\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/verify-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"verify-otp"
							]
						},
						"description": "Verify OTP and get JWT token. Token is automatically saved to collection variables."
					},
					"response": []
				},
				{
					"name": "5. Resend OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"creator@example.com\",\n  \"channel\": \"email\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/resend-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"resend-otp"
							]
						},
						"description": "Resend OTP to email or phone"
					},
					"response": []
				},
