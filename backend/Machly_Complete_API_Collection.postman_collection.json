						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Complete Web Development Bootcamp\",\n  \"description\": \"Learn web development from scratch\",\n  \"thumbnail\": \"https://example.com/thumbnail.jpg\",\n  \"price\": 49.99,\n  \"category\": \"Web Development\",\n  \"tags\": [\"javascript\", \"html\", \"css\", \"react\"],\n  \"level\": \"Beginner\",\n  \"language\": \"English\",\n  \"status\": \"DRAFT\"\n}"
						},
