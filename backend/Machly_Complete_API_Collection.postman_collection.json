								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "category",
									"value": "Web Development",
									"disabled": true
								},
								{
									"key": "level",
									"value": "Beginner",
									"disabled": true
								},
								{
									"key": "status",
									"value": "PUBLISHED",
									"disabled": true
								},
								{
									"key": "search",
									"value": "javascript",
									"disabled": true
								}
							]
