		{
			"name": "Courses",
			"item": [
				{
					"name": "1. Create Course",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.course) {",
									"    pm.collectionVariables.set(\"course_id\", jsonData.data.course.id);",
									"    console.log(\"Course ID saved:\", jsonData.data.course.id);",
									"}"
