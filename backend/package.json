{
  "name": "task-management-supabase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev --name init",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "rebuild": "prisma generate && npm run build",
    "seed": "npx prisma db seed",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop machly-backend",
    "pm2:restart": "pm2 restart machly-backend",
    "pm2:delete": "pm2 delete machly-backend",
    "pm2:logs": "pm2 logs machly-backend",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.907.0",
    "@mux/mux-node": "^12.8.0",
    "@prisma/client": "^5.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "axios": "^1.12.2",
    "body-parser": "^1.20.2",
    "cashfree-payout": "^0.0.14",
    "cashfree-pg": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.1",
    "rate-limiter-flexible": "^8.0.1",
    "socket.io": "^4.8.1",
    "ttl-cache": "^1.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/nodemailer": "^7.0.2",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
