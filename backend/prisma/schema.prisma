generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  email                     String                      @unique
  name                      String?
  phone                     String?                     @unique
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt
  last_login                DateTime?
  id                        String                      @id @default(uuid())
  profile_image             String?
  user_type                 UserType[]                  @default([USER])
  dob                       String?                     @db.VarChar(10)
  pan_number                String?                     @db.VarChar(20)
  kyc_verified              Boolean                     @default(false)
  kyc_status                String?                     @db.VarChar(20)
  kyc_verified_at           DateTime?
  kyc_verification_id       String?
  fcm_token                 String?
  instagram_link            String?
  linkedin_link             String?
  youtube_link              String?
  facebook_link             String?
  conversation_participants conversation_participants[]
  courses                   courses[]
  bank_account              creator_bank_accounts?
  enrollments               enrollments[]
  group_members             group_members[]
  created_groups            groups[]
  kyc_verifications         kyc_verifications[]
  messages                  messages[]
  settlements               settlements[]
  transactions              transactions[]
  webinar_enrollments       webinar_enrollments[]
  webinar_transactions      webinar_transactions[]
  webinars                  webinars[]

  @@map("users")
}

model courses {
  id            String         @id @default(uuid())
  title         String
  description   String?
  thumbnail     String?
  price         Float          @default(0)
  status        CourseStatus   @default(DRAFT)
  creator_id    String
  category      String?
  tags          String[]       @default([])
  duration      Int?
  level         String?
  language      String?        @default("English")
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  published_at  DateTime?
  thumbnail_url String?
  creator       users          @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  enrollments   enrollments[]
  transactions  transactions[]
  videos        videos[]

  @@index([creator_id])
  @@index([status])
  @@map("courses")
}

model videos {
  id              String      @id @default(uuid())
  course_id       String
  title           String
  description     String?
  mux_asset_id    String?     @unique
  mux_upload_id   String?     @unique
  mux_playback_id String?
  upload_url      String?
  playback_url    String?
  thumbnail_url   String?
  duration        Int?
  status          VideoStatus @default(UPLOADING)
  order           Int         @default(0)
  is_free         Boolean     @default(false)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  course          courses     @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([course_id])
  @@index([status])
  @@map("videos")
}

model transactions {
  id                String            @id @default(uuid())
  user_id           String
  course_id         String
  amount            Float
  currency          String            @default("INR")
  status            TransactionStatus @default(PENDING)
  payment_method    PaymentMethod     @default(CASHFREE)
  payment_details   Json?
  failure_reason    String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  completed_at      DateTime?
  cashfree_order_id String?           @unique
  cf_payment_id     String?           @unique
  course            courses           @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user              users             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([course_id])
  @@index([status])
  @@index([cashfree_order_id])
  @@index([cf_payment_id])
  @@map("transactions")
}

model enrollments {
  id              String    @id @default(uuid())
  user_id         String
  course_id       String
  enrolled_at     DateTime  @default(now())
  completed_at    DateTime?
  progress        Float     @default(0)
  last_watched_at DateTime?
  transaction_id  String?   @unique
  course          courses   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id])
  @@index([user_id])
  @@index([course_id])
  @@map("enrollments")
}

model webinars {
  id               String                 @id @default(uuid())
  title            String
  description      String?
  thumbnail        String?
  thumbnail_url    String?
  price            Float                  @default(0)
  status           WebinarStatus          @default(DRAFT)
  creator_id       String
  category         String?
  tags             String[]               @default([])
  scheduled_at     DateTime
  duration         Int?
  timezone         String?                @default("UTC")
  zoom_meeting_id  String?                @unique
  zoom_join_url    String?
  zoom_start_url   String?
  zoom_password    String?
  max_participants Int?
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  published_at     DateTime?
  start_time       String?
  end_time         String?
  enrollments      webinar_enrollments[]
  transactions     webinar_transactions[]
  creator          users                  @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([creator_id])
  @@index([status])
  @@index([scheduled_at])
  @@map("webinars")
}

model webinar_transactions {
  id                String            @id @default(uuid())
  user_id           String
  webinar_id        String
  amount            Float
  currency          String            @default("INR")
  status            TransactionStatus @default(PENDING)
  payment_method    PaymentMethod     @default(CASHFREE)
  payment_details   Json?
  failure_reason    String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  completed_at      DateTime?
  cashfree_order_id String?
  cf_payment_id     String?
  user              users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  webinar           webinars          @relation(fields: [webinar_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([webinar_id])
  @@index([status])
  @@map("webinar_transactions")
}

model webinar_enrollments {
  id             String    @id @default(uuid())
  user_id        String
  webinar_id     String
  transaction_id String?   @unique
  enrolled_at    DateTime  @default(now())
  attended       Boolean   @default(false)
  attended_at    DateTime?
  user           users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  webinar        webinars  @relation(fields: [webinar_id], references: [id], onDelete: Cascade)

  @@unique([user_id, webinar_id])
  @@index([user_id])
  @@index([webinar_id])
  @@map("webinar_enrollments")
}

model conversations {
  id              String                      @id @default(uuid())
  type            ConversationType            @default(DIRECT)
  name            String?
  group_id        String?                     @unique
  last_message_at DateTime                    @default(now())
  created_at      DateTime                    @default(now())
  updated_at      DateTime                    @updatedAt
  participants    conversation_participants[]
  group           groups?                     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  messages        messages[]

  @@index([type])
  @@index([last_message_at])
  @@map("conversations")
}

model conversation_participants {
  id              String        @id @default(uuid())
  conversation_id String
  user_id         String
  joined_at       DateTime      @default(now())
  last_read_at    DateTime?
  conversation    conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user            users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@index([user_id])
  @@index([conversation_id])
  @@map("conversation_participants")
}

model messages {
  id              String        @id @default(uuid())
  conversation_id String
  sender_id       String
  content         String
  type            MessageType   @default(TEXT)
  attachment_url  String?
  is_read         Boolean       @default(false)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  conversation    conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender          users         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([sender_id])
  @@index([created_at])
  @@map("messages")
}

model groups {
  id           String          @id @default(uuid())
  name         String
  description  String?
  avatar_url   String?
  creator_id   String
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  conversation conversations?
  members      group_members[]
  creator      users           @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([creator_id])
  @@map("groups")
}

model group_members {
  id        String   @id @default(uuid())
  group_id  String
  user_id   String
  is_admin  Boolean  @default(false)
  joined_at DateTime @default(now())
  group     groups   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([group_id])
  @@index([user_id])
  @@map("group_members")
}

model kyc_verifications {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id           String
  pan_number        String?   @db.VarChar(10)
  status            KYCStatus @default(PENDING)
  verification_type String?   @default("PAN") @db.VarChar(20)
  pan_details       Json?
  match_details     Json?
  unique_request_id String?   @db.VarChar(255)
  verified_at       DateTime?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @default(now()) @updatedAt
  user              users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([pan_number], map: "idx_kyc_pan")
  @@index([status], map: "idx_kyc_status")
  @@index([user_id], map: "idx_kyc_user_id")
  @@map("kyc_verifications")
}

model creator_bank_accounts {
  id                      String   @id @default(uuid())
  user_id                 String   @unique
  account_number          String
  ifsc_code               String   @db.VarChar(11)
  beneficiary_name        String
  bank_name               String?
  account_type            String?  @default("savings") @db.VarChar(20)
  is_verified             Boolean  @default(false)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  cashfree_beneficiary_id String?  @unique
  user                    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("creator_bank_accounts")
}

model settlements {
  id                   String             @id @default(uuid())
  creator_id           String
  total_gross_amount   Float
  platform_fee         Float
  gst_on_platform_fee  Float
  tds_amount           Float              @default(0)
  net_amount           Float
  status               SettlementStatus   @default(PENDING)
  settlement_date      DateTime
  processed_at         DateTime?
  payout_status        PayoutStatus       @default(PENDING)
  failure_reason       String?
  retry_count          Int                @default(0)
  payout_details       Json?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  cashfree_transfer_id String?            @unique
  items                settlement_items[]
  creator              users              @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([creator_id])
  @@index([status])
  @@index([settlement_date])
  @@index([payout_status])
  @@map("settlements")
}

model settlement_items {
  id                  String      @id @default(uuid())
  settlement_id       String
  transaction_type    String      @db.VarChar(20)
  transaction_id      String
  course_id           String?
  webinar_id          String?
  gross_amount        Float
  platform_fee        Float
  gst_on_platform_fee Float
  tds_amount          Float       @default(0)
  net_amount          Float
  created_at          DateTime    @default(now())
  settlement          settlements @relation(fields: [settlement_id], references: [id], onDelete: Cascade)

  @@unique([transaction_type, transaction_id])
  @@index([settlement_id])
  @@index([transaction_id])
  @@map("settlement_items")
}

model wallet_transactions {
  id                  String         @id @default(uuid())
  creator_id          String
  type                WalletTxType
  amount              Float
  net_amount          Float
  platform_fee        Float
  gst_on_platform_fee Float
  tds_amount          Float          @default(0)
  status              WalletTxStatus @default(PENDING_SETTLEMENT)
  title               String
  description         String?
  transaction_type    String         @db.VarChar(20)
  transaction_id      String
  course_id           String?
  webinar_id          String?
  settlement_id       String?
  settlement_eta      DateTime?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  @@unique([transaction_type, transaction_id])
  @@index([creator_id])
  @@index([status])
  @@map("wallet_transactions")
}

model sessions {
  id           String        @id @default(uuid())
  call_id      String        @unique
  caller_id    String
  receiver_id  String
  mode         SessionMode
  status       SessionStatus @default(PENDING)
  duration     Int           @default(0)
  amount       Float         @default(0)
  rate_per_min Float         @default(0)
  started_at   DateTime?
  ended_at     DateTime?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  scheduled_at DateTime?

  @@index([caller_id])
  @@index([receiver_id])
  @@index([status])
  @@index([scheduled_at])
  @@map("sessions")
}

model session_experts {
  id             String   @id @default(uuid())
  user_id        String   @unique
  profession     String
  bio            String?
  categories     String[] @default([])
  experience     Int      @default(0)
  audio_rate     Float    @default(0)
  video_rate     Float    @default(0)
  languages      String[] @default([])
  is_active      Boolean  @default(true)
  is_available   Boolean  @default(false)
  total_sessions Int      @default(0)
  total_minutes  Int      @default(0)
  total_earnings Float    @default(0)
  rating         Float    @default(0)
  review_count   Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([is_active, is_available], map: "session_experts_active_avail_idx")
  @@map("session_experts")
}

model session_products {
  id          String      @id @default(uuid())
  creator_id  String
  title       String
  description String?
  duration    Int
  price       Float
  mode        SessionMode
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  @@index([creator_id])
  @@map("session_products")
}

model expert_availability {
  id          String   @id @default(uuid())
  expert_id   String
  day_of_week Int
  start_time  String
  end_time    String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([expert_id])
  @@index([expert_id, day_of_week])
  @@map("expert_availability")
}

enum UserType {
  USER
  CREATOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  MANUAL
  FREE
  CASHFREE
}

enum WebinarStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum KYCStatus {
  PENDING
  VERIFIED
  FAILED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum WalletTxStatus {
  PENDING_SETTLEMENT
  SETTLED
  FAILED
}

enum SessionStatus {
  PENDING
  ACTIVE
  COMPLETED
  MISSED
  CANCELLED
}

enum SessionMode {
  CALL
  VIDEO
}

model telegram_channels {
  id                  String                    @id @default(uuid())
  channel_id          String                    @unique
  channel_title       String
  creator_telegram_id String
  creator_username    String?
  price_inr           Float
  description         String?
  status              String                    @default("ACTIVE")
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt
  subscriptions       telegram_subscriptions[]

  @@index([creator_telegram_id])
  @@index([status])
  @@map("telegram_channels")
}

model telegram_subscriptions {
  id                 String            @id @default(uuid())
  channel_id         String
  buyer_telegram_id  String
  buyer_username     String?
  invite_link        String?
  amount_inr         Float
  payment_method     String            @default("MOCK")
  payment_reference  String?
  status             String            @default("ACTIVE")
  expires_at         DateTime?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  channel            telegram_channels @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  @@index([channel_id])
  @@index([buyer_telegram_id])
  @@index([status])
  @@map("telegram_subscriptions")
}
