# Read ENVIRONMENT.md for purpose, required/optional conditions, and secure sources.
# Set only applicable values in your ignored local environment file.
# Do not paste credentials into chat or copy unused empty credential fields.

# Supabase project reference
HOT_UPDATER_SUPABASE_PROJECT_ID=

# Project name used when creating a Supabase project
HOT_UPDATER_SUPABASE_PROJECT_NAME=

# Organization slug used when creating a Supabase project
HOT_UPDATER_SUPABASE_ORGANIZATION_SLUG=

# Region used when creating a Supabase project
HOT_UPDATER_SUPABASE_REGION=

# Supabase personal access token
SUPABASE_ACCESS_TOKEN=

# Storage bucket name
HOT_UPDATER_SUPABASE_BUCKET_NAME=

# Edge Function name
HOT_UPDATER_SUPABASE_FUNCTION_NAME=

# Database password, when required by the linked project
HOT_UPDATER_SUPABASE_DB_PASSWORD=

# Selected project's API URL; see ENVIRONMENT.md
HOT_UPDATER_SUPABASE_URL=

# Local server-side service-role or secret key; never put it in chat or the app
HOT_UPDATER_SUPABASE_SERVICE_ROLE_KEY=

# Client API key sent in x-api-key; reuse the existing one or run app/provision-client-credential.mjs after schema setup
HOT_UPDATER_API_KEY=
